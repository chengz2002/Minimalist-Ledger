<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_1x4_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="10dp">

    <!-- Left Stats (Month Expense & Budget Usage) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minWidth="88dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本月支出"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_1x4_month_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¥0.00"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_1x4_budget_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="预算剩余 ¥0.00"
            android:textColor="#10B981"
            android:textSize="10sp"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Center Daily Spending Bar Chart -->
    <ImageView
        android:id="@+id/iv_1x4_chart"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitXY"
        android:contentDescription="每日支出柱状图" />

    <!-- Right Quick Add Action Button -->
    <TextView
        android:id="@+id/btn_1x4_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ 记账"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:background="@drawable/widget_btn_bg" />

</LinearLayout>
